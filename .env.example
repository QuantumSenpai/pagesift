NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
DATABASE_URL=postgresql://pagesift:pagesift_dev_password@127.0.0.1:5432/pagesift
DATABASE_URL_UNPOOLED=postgresql://pagesift:pagesift_dev_password@127.0.0.1:5432/pagesift
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000
CORS_ALLOWED_ORIGINS=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,http://localhost:5173
ALLOWED_REDIRECT_URIS=https://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.chromiumapp.org/oauth2,http://127.0.0.1:5173/auth/callback
JWT_ACCESS_SECRET=replace_with_at_least_32_byte_high_entropy_secret_value_0000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_STATE_TTL_SECONDS=600
OAUTH_HANDOFF_TTL_SECONDS=60
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://127.0.0.1:3000/v1/auth/oauth/google/callback
OIDC_ISSUER=https://accounts.google.com
OIDC_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
OIDC_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
OIDC_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WRITE_WINDOW_MS=60000
