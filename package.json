{
  "name": "pagesift-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/build-extension.ts",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:extension": "tsx scripts/build-extension.ts",
    "validate:extension": "tsx scripts/validate-extension-package.ts",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/cli-migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.json\"",
    "check:no-comments": "tsx scripts/check-no-comments.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "smoke": "tsx scripts/smoke-test.ts",
    "loadtest": "tsx scripts/load-test.ts",
    "bench:extension": "tsx scripts/extension-benchmark.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/swagger": "9.9.5",
    "@types/dompurify": "3.0.5",
    "dompurify": "3.4.18",
    "fastify": "5.12.8",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "jose": "6.2.18",
    "kysely": "0.29.9",
    "openid-client": "6.9.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.17",
    "@types/pg": "8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "10.15.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "openapi-types": "12.1.3",
    "playwright": "^1.65.1",
    "prettier": "3.8.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
